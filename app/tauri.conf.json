{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Errand-AI",
  "version": "0.1.0",
  "identifier": "com.errandai.app",
  "build": {
    "frontendDist": "../frontend/build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "Errand-AI",
        "width": 1040,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": { "../sidecars/browser-agent": "browser-agent" },
    "externalBin": ["binaries/errandd"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
