# Build output
/target/
**/target/
node_modules/
frontend/.svelte-kit/
frontend/build/
dist/

# The dev overlay. Local model endpoints, test tokens, machine-specific paths.
# This is the file that keeps private LAN addresses out of the public repo, so
# it is ignored before it exists rather than after.
config.dev.json
config.local.json
.env
.env.*
!.env.example

# Signing material, never in a repo
*.p12
*.mobileprovision
AuthKey_*.p8
updater.key
*.pem

# Runtime data (the real thing lives in Application Support)
*.db
*.db-wal
*.db-shm
/runs/
/playbooks/
/profiles/
/logs/

# macOS
.DS_Store

# Unattributed local build note, not authored by this session. Kept out of the
# public repo pending review (it references private paths).
SPEC-M1.md

# Sidecar dependencies (installed with npm, not vendored). The lockfile is
# tracked on purpose: the sidecar is the browser, so CI has to install the exact
# same playwright-core the shipped app was built and tested against, and npm ci
# refuses to run without it.
sidecars/browser-agent/node_modules/

# TypeScript client build output
packages/client/dist/
packages/client/node_modules/
packages/client/package-lock.json

# Frontend and app build output
frontend/node_modules/
frontend/build/
frontend/.svelte-kit/
frontend/package-lock.json
app/gen/
app/icons/icon.iconset/

# The daemon staged for the bundler. Built from source by scripts/dev-install.sh
# and by CI, never committed.
app/binaries/
